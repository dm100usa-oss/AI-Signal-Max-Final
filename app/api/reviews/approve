import { NextResponse } from "next/server";
import { Redis } from "@upstash/redis";

const redis = new Redis({
  url: process.env.UPSTASH_REDIS_REST_URL!,
  token: process.env.UPSTASH_REDIS_REST_TOKEN!,
});

export async function POST(req: Request) {
  try {
    const { name, text } = await req.json();
    if (!name || !text) {
      return NextResponse.json({ ok: false, error: "Missing fields" }, { status: 400 });
    }

    const review = {
      name,
      text,
      date: new Date().toISOString(),
      approved: true,
    };

    // Добавляем в основной список
    await redis.lpush("reviews:list", JSON.stringify(review));

    // Удаляем из очереди ожидания (не обязательно, но аккуратно)
    const pending = await redis.lrange("reviews:pending", 0, -1);
    const updated = pending.filter((r) => {
      try {
        const parsed = JSON.parse(r);
        return !(parsed.name === name && parsed.text === text);
      } catch {
        return true;
      }
    });
    await redis.del("reviews:pending");
    for (const r of updated) {
      await redis.lpush("reviews:pending", r);
    }

    return NextResponse.json({ ok: true });
  } catch (err) {
    console.error("Ошибка при одобрении:", err);
    return NextResponse.json({ ok: false, error: "Server error" }, { status: 500 });
  }
}
